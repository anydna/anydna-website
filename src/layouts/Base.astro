---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

// Preload the above-the-fold fonts so they download in parallel with the CSS
// (removes the load waterfall and the visible font swap on first paint).
import interBody from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import groteskNav from '@fontsource/space-grotesk/files/space-grotesk-latin-500-normal.woff2?url';
import groteskHead from '@fontsource/space-grotesk/files/space-grotesk-latin-600-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'UK-based specialists in community metabarcoding. Simple processes, transparent workflows, and comprehensive biodiversity data from soil or water samples.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  alternateName: site.name,
  url: site.url,
  email: site.email,
  slogan: site.strapline,
  description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '128 City Road',
    addressLocality: 'London',
    postalCode: 'EC1V 2NX',
    addressCountry: 'GB',
  },
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#171b2e" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload above-the-fold fonts (parallel with CSS, no swap) -->
    <link rel="preload" href={interBody} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={groteskHead} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={groteskNav} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal-on-scroll — progressive enhancement, respects reduced motion.
      const els = document.querySelectorAll('.reveal');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
