---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { workflow, proofPoints } from '../data/site';
---
<Base title="AnyDNA | Specialist Metabarcoding Services">
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <canvas id="heroHelix" class="hero-helix" aria-hidden="true"></canvas>

    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Simple process. Maximum effect.</span>
        <h1>Precision eDNA solutions for biodiversity.</h1>
        <p class="lead">
          Based in the UK, AnyDNA specialises exclusively in community metabarcoding.
          Send us your soil or water samples, and we deliver clear data across the
          entire tree of life.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn--primary">
            Order sampling kits <Icon name="arrow" size={18} class="arrow" />
          </a>
          <a href="/services" class="btn btn--ghost">View services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PROOF BAND ===================== -->
  <section class="proof" aria-label="Why AnyDNA">
    <div class="container proof-grid">
      {proofPoints.map((p) => (
        <div class="proof-item reveal">
          <span class="proof-value">{p.value}</span>
          <span class="proof-label">{p.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== WORKFLOW ===================== -->
  <section class="section tint">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The transparent workflow</span>
        <h2>Simple sampling. Clear data.</h2>
        <p>Three steps from field to findings — no pipelines to wrestle with, no black boxes.</p>
      </div>

      <ol class="workflow">
        {workflow.map((s, i) => (
          <li class="workflow-step reveal" style={`transition-delay:${i * 90}ms`}>
            <div class="workflow-top">
              <span class="workflow-icon"><Icon name={s.icon} size={26} /></span>
              <span class="workflow-num">{s.step}</span>
            </div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="section">
    <div class="container">
      <div class="cta reveal">
        <div class="cta-copy">
          <h2>Get clear data across the entire tree of life.</h2>
          <p>Stop wrestling with pipelines. Order your kits and let our UK lab do the science.</p>
        </div>
        <div class="cta-actions">
          <a href="/contact" class="btn btn--primary">Order sampling kits <Icon name="arrow" size={18} class="arrow" /></a>
          <a href="/pricing" class="btn btn--on-dark btn--ghost">See pricing</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(120% 100% at 88% -10%, rgba(244, 206, 255, 0.55) 0%, transparent 55%),
      radial-gradient(90% 90% at -5% 5%, rgba(89, 150, 255, 0.16) 0%, transparent 48%),
      var(--paper);
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }
  .hero-helix {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.95;
    pointer-events: none;
  }

  .hero-inner { position: relative; z-index: 1; }
  .hero-copy { max-width: 640px; }
  .hero-copy .eyebrow { margin-bottom: 1.25rem; }
  .hero-copy h1 { margin-bottom: 1.25rem; }
  .hero-copy .lead { max-width: 54ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2rem; }

  @media (max-width: 620px) {
    .hero-helix { opacity: 0.32; }
  }

  /* Proof band */
  .proof { border-block: 1px solid var(--line); background: var(--paper); }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .proof-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-block: clamp(1.75rem, 4vw, 2.5rem);
    padding-inline: 0.5rem;
    text-align: center;
    border-left: 1px solid var(--line);
  }
  .proof-item:first-child { border-left: none; }
  .proof-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    color: var(--brand);
    letter-spacing: -0.02em;
  }
  .proof-label { font-size: 0.92rem; color: var(--muted); }
  @media (max-width: 620px) {
    .proof-grid { grid-template-columns: 1fr 1fr; }
    .proof-item:nth-child(odd) { border-left: none; }
    .proof-item:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  }

  /* Workflow */
  .workflow {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    counter-reset: step;
  }
  .workflow-step {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2rem);
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .workflow-step:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .workflow-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.1rem; }
  .workflow-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px; height: 52px;
    border-radius: 14px;
    background: var(--accent-050);
    color: var(--brand);
  }
  .workflow-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--surface-2);
    -webkit-text-stroke: 1px var(--line);
  }
  .workflow-step h3 { margin-bottom: 0.5rem; }
  .workflow-step p { color: var(--muted); font-size: 0.98rem; }
  @media (max-width: 780px) { .workflow { grid-template-columns: 1fr; } }

  /* CTA */
  .cta {
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(89, 150, 255, 0.3) 0%, transparent 52%),
      radial-gradient(90% 130% at 0% 100%, rgba(244, 206, 255, 0.16) 0%, transparent 55%),
      var(--ink);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: clamp(2.25rem, 5vw, 3.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .cta h2 { color: #fff; margin-bottom: 0.6rem; }
  .cta-copy { max-width: 46ch; }
  .cta-copy p { color: rgba(255,255,255,0.75); }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
</style>

<script>
  // Rotating DNA double-helix on the hero canvas (AnyDNA blue + pink).
  const canvas = document.getElementById('heroHelix') as HTMLCanvasElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const BLUE = '89,150,255';   // --brand
    const PINK = '226,166,242';  // --pink-300
    const INK = '23,27,46';      // --ink (faint base letters)
    const bases = 'ATGCTAGCATCGATGCTAGC'.split('');
    let w = 0, h = 0, t = 0, raf = 0;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      const amp = Math.min(w, 900) * 0.13;
      // Sit just to the right of the ~640px text column — close, but never overlapping.
      let cx;
      if (w > 900) {
        const contentLeft = (w - Math.min(w, 1120)) / 2 + 32; // container padding
        const textRight = contentLeft + 640;                  // hero-copy max-width
        cx = textRight + 36 + amp;                             // small gap after the text
        const maxCx = w - 20 - amp;                            // keep it on-screen
        if (cx > maxCx) cx = maxCx;
      } else {
        cx = w * 0.72;
      }
      const rungs = 40;
      const span = h * 1.15;
      const top = -h * 0.05;

      for (let i = 0; i < rungs; i++) {
        const p = i / rungs;
        const y = top + p * span;
        const phase = p * Math.PI * 4 + t;
        const x1 = cx + Math.sin(phase) * amp;          // blue strand
        const x2 = cx + Math.sin(phase + Math.PI) * amp; // pink strand
        const d1 = (Math.cos(phase) + 1) / 2;            // strand-A depth (front/back)
        const d2 = 1 - d1;                               // strand-B depth

        // connecting rung
        ctx.beginPath();
        ctx.moveTo(x1, y);
        ctx.lineTo(x2, y);
        ctx.strokeStyle = `rgba(${BLUE},${0.05 + Math.max(d1, d2) * 0.13})`;
        ctx.lineWidth = 1;
        ctx.stroke();

        // blue backbone node
        ctx.beginPath();
        ctx.arc(x1, y, 1.6 + d1 * 2.8, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${BLUE},${0.3 + d1 * 0.5})`;
        ctx.fill();

        // pink backbone node
        ctx.beginPath();
        ctx.arc(x2, y, 1.6 + d2 * 2.8, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${PINK},${0.35 + d2 * 0.5})`;
        ctx.fill();

        // occasional faint base letter
        if (i % 3 === 0) {
          ctx.font = '10px ui-monospace, "SF Mono", Menlo, monospace';
          ctx.fillStyle = `rgba(${INK},${0.05 + Math.max(d1, d2) * 0.1})`;
          ctx.fillText(bases[i % bases.length], (x1 + x2) / 2 - 3, y - 5);
        }
      }

      if (!reduce) {
        t += 0.006;
        raf = requestAnimationFrame(draw);
      }
    };

    resize();
    draw();

    window.addEventListener('resize', () => {
      resize();
      if (reduce) draw();
    });

    // Pause the loop when the tab is hidden (saves battery/CPU).
    if (!reduce) {
      document.addEventListener('visibilitychange', () => {
        cancelAnimationFrame(raf);
        if (!document.hidden) draw();
      });
    }
  }
</script>
